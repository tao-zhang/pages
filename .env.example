# Copy to .env.local and fill in once available. All optional —
# the site builds and runs fine without any of these set.

# Production domain, once purchased/pointed. Used in canonical URLs,
# sitemap.xml, and Open Graph tags. In CI (.github/workflows/deploy.yml)
# this is computed automatically from the GitHub Pages URL unless set here
# as a repo variable (Settings > Secrets and variables > Actions > Variables).
NEXT_PUBLIC_SITE_URL=https://example.com

# Only needed for a GitHub Pages *project* site (served from a /repo-name/
# subpath rather than a domain root) — CI computes this automatically too.
# Leave unset for local dev and for a custom-domain deploy.
NEXT_PUBLIC_BASE_PATH=

# GA4 measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable analytics.
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML tag verification code (the "content" value
# from the meta tag GSC gives you, not the whole tag).
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional, e.g. @yourhandle
NEXT_PUBLIC_TWITTER_HANDLE=
